{
  "name": "paxzas-vscode",
  "displayName": "Paxzas CUDA Analyzer",
  "description": "Local PTX/SASS fast analysis inside VS Code (no Python, no network).",
  "version": "0.0.1",
  "publisher": "paxzas",
  "repository": {
    "type": "git",
    "url": "https://github.com/shathil/PaxZas"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "icon.png",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:paxzas.analyzeWithLaunchSpec",
    "onCommand:paxzas.kernelDiagnosis"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "check": "npm run compile",
    "test": "vitest run",
    "test:watch": "vitest",
    "vsix": "npm install && npm run compile && npx --yes @vscode/vsce package"
  },
  "contributes": {
    "commands": [
      {
        "command": "paxzas.analyzeWithLaunchSpec",
        "title": "Paxzas: Analyze CUDA File with Launch Spec"
      },
      {
        "command": "paxzas.kernelDiagnosis",
        "title": "Paxzas: Kernel Analysis",
        "icon": "$(search)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "paxzas.analyzeWithLaunchSpec",
          "when": "resourceExtname == .ptx || resourceExtname == .cu || resourceExtname == .sass",
          "group": "navigation"
        },
        {
          "command": "paxzas.kernelDiagnosis",
          "when": "resourceExtname == .ptx || resourceExtname == .cu || resourceExtname == .sass",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "paxzas.analyzeWithLaunchSpec",
          "when": "resourceExtname == .ptx || resourceExtname == .cu || resourceExtname == .sass",
          "group": "navigation"
        },
        {
          "command": "paxzas.kernelDiagnosis",
          "when": "resourceExtname == .ptx || resourceExtname == .cu || resourceExtname == .sass",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "paxzas.analyzeWithLaunchSpec",
          "when": "editorLangId == cuda || resourceExtname == .ptx || resourceExtname == .cu || resourceExtname == .sass || resourceExtname == .s",
          "group": "navigation@2"
        },
        {
          "command": "paxzas.kernelDiagnosis",
          "when": "editorLangId == cuda || resourceExtname == .ptx || resourceExtname == .cu || resourceExtname == .sass || resourceExtname == .s",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "paxzas.kernelDiagnosis",
          "when": "editorLangId == cuda || resourceExtname == .ptx || resourceExtname == .cu || resourceExtname == .sass"
        }
      ]
    },
    "configuration": {
      "title": "Paxzas CUDA Analyzer",
      "properties": {
        "paxzas.gpuPreset": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "ampere-like-default",
            "a100",
            "rtx-4090",
            "h100-sxm",
            "h100-pcie",
            "h200",
            "b200",
            "gb200",
            "blackwell-consumer-default"
          ],
          "description": "GPU specs for occupancy heuristics and capability what-if views. \"auto\" uses nvidia-smi when available; named presets force architecture/device assumptions."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.3"
  }
}
